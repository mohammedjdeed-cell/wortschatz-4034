rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function shortStr(v, n) { return v is string && v.size() <= n; }

    // Private learning progress: one document per account.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Leaderboard card, opt-in: exists only while the learner chose "Auf der Rangliste zeigen".
    match /profiles/{uid} {
      allow read: if isOwner(uid) || (signedIn() && resource.data.visible == true);
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'known', 'learning', 'streak', 'xp', 'visible', 'updated'])
        && request.resource.data.visible == true
        && shortStr(request.resource.data.name, 60)
        && request.resource.data.known is int && request.resource.data.known <= 50000
        && request.resource.data.learning is int && request.resource.data.learning <= 50000;
    }

    // Daily reminder: this learner's push tokens, hour and time zone. Read by the server (Admin SDK) in /api/remind.
    match /push/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['on', 'hour', 'tz', 'tokens', 'last', 'updated'])
        && request.resource.data.hour is int && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
        && request.resource.data.tokens.size() <= 10;
    }

    // Wort-Duell: two signed-in players answer the same 10 questions. Readable by code, never listable.
    match /duels/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'guest', 'guestName', 'state', 'qs', 'pA', 'pB', 'created', 'label'])
        && request.resource.data.qs.size() <= 20 && request.resource.data.guest == '';
      allow update: if signedIn() && (
        (resource.data.host == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pA', 'state']))
        || (resource.data.guest == '' && request.resource.data.guest == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'guestName', 'state']))
        || (resource.data.guest == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pB', 'state'])));
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }

    // Shared AI-generated example sentences, one doc per word rank.
    // Create-once: nobody can overwrite or delete an existing entry from the client.
    match /sentences/{rank} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['emoji', 'pl', 'de', 'en', 'kde', 'ken', 'tip', 'syn', 'ant', 'konj', 'ar', 'ar_s', 'ar_k', 'by'])
        && shortStr(request.resource.data.de, 240)
        && shortStr(request.resource.data.en, 240)
        && shortStr(request.resource.data.emoji, 16)
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
