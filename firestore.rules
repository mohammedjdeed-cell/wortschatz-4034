rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function shortStr(v, n) { return v is string && v.size() <= n; }

    // Private learning progress: one document per account.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Public profile card for the leaderboard (readable by signed-in users only).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'known', 'learning', 'streak', 'xp', 'updated'])
        && shortStr(request.resource.data.name, 60)
        && request.resource.data.known is int && request.resource.data.known <= 4034
        && request.resource.data.learning is int && request.resource.data.learning <= 4034;
    }

    // Shared AI-generated example sentences, one doc per word rank.
    // Create-once: nobody can overwrite or delete an existing entry from the client.
    match /sentences/{rank} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['emoji', 'pl', 'de', 'en', 'kde', 'ken', 'tip', 'syn', 'ant', 'konj', 'by'])
        && shortStr(request.resource.data.de, 240)
        && shortStr(request.resource.data.en, 240)
        && shortStr(request.resource.data.emoji, 16)
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
