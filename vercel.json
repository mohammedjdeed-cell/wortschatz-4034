{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/sentences.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://wortschatz-4034.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://wortschatz-4034.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/((?!api/|__/|assets/|icons/|sw.js|workbox-|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}