{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/sentences.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/((?!api/|assets/|icons/|sw.js|workbox-|manifest.webmanifest).*)", "destination": "/index.html" }]
}
