# ---- Client (Vite) — copy to .env.local, also set these in Vercel / GitHub secrets ----
# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Where the AI endpoint lives. Empty = same origin (/api on Vercel).
# For the Firebase-hosted build, point it at your Vercel deployment:
VITE_API_BASE=https://wortschatz-4034.vercel.app

# ---- Server (Vercel function only — never prefix with VITE_) ----
ANTHROPIC_API_KEY=
FIREBASE_PROJECT_ID=your-project
# Optional
# ANTHROPIC_MODEL=claude-haiku-5-5
# ALLOWED_ORIGINS=https://your-project.web.app,https://your-project.firebaseapp.com,https://wortschatz-4034.vercel.app
